# Quick extraction - just the essentials
extract_fred_data <- function(response) {
response$observations |>
map_dfr(~ tibble(
date = as.Date(.x$date),
value = if(.x$value == ".") NA_real_ else as.numeric(.x$value)
)) |>
filter(!is.na(value))
}
# Usage
djia_data <- get_fred_data("DJIA") |> extract_fred_data()
